{
  "name": "set-visualizer",
  "productName": "Set Visualizer",
  "version": "0.1.0",
  "description": "Turn a recorded DJ set into a YouTube-ready visualizer video",
  "main": "out/main/index.js",
  "author": "Alan",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "dev:web": "vite --config vite.web.config.ts",
    "build:web": "vite build --config vite.web.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:browser": "tsx test/browser/run.ts",
    "render": "tsx scripts/render-cli.ts",
    "compare-analysis": "tsx scripts/compare-analysis.ts",
    "build:wasm": "tsx scripts/build-wasm.ts",
    "dist": "electron-vite build && electron-builder",
    "postinstall": "electron-builder install-app-deps",
    "make-tutorial": "tsx scripts/make-tutorial.ts"
  },
  "dependencies": {
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "i18next": "^26.5.11",
    "mediabunny": "1.61.4",
    "react-i18next": "^17.1.9",
    "yt-search": "^2.13.1"
  },
  "devDependencies": {
    "@fontsource/inter": "^5.3.0",
    "@napi-rs/canvas": "^1.0.13",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/yt-search": "^2.10.3",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^7.3.7",
    "vitest": "^5.0.5",
    "wabt": "1.0.39"
  },
  "build": {
    "appId": "com.setvisualizer.app",
    "productName": "Set Visualizer",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "out/**",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/**",
      "node_modules/ffprobe-static/**"
    ],
    "fileAssociations": [
      {
        "ext": "djvis",
        "name": "Set Visualizer project",
        "role": "Editor"
      }
    ],
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.music"
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "AudioVideo"
    },
    "extraResources": [
      {
        "from": "resources/tutorial",
        "to": "tutorial",
        "filter": [
          "tutorial.*"
        ]
      }
    ]
  }
}
