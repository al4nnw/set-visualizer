{
  "name": "set-visualizer",
  "productName": "Set Visualizer",
  "version": "0.1.0",
  "description": "Turn a recorded DJ set into a YouTube-ready visualizer video, in the browser",
  "author": "Alan",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "dev": "vite --config vite.web.config.ts",
    "build": "vite build --config vite.web.config.ts",
    "preview": "vite preview --config vite.web.config.ts",
    "dev:web": "npm run dev",
    "build:web": "npm run build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:browser": "tsx test/browser/run.ts",
    "compare-analysis": "tsx scripts/compare-analysis.ts",
    "build:wasm": "tsx scripts/build-wasm.ts",
    "make-tutorial": "tsx scripts/make-tutorial.ts"
  },
  "dependencies": {
    "i18next": "^26.5.11",
    "mediabunny": "1.61.4",
    "react-i18next": "^17.1.9"
  },
  "devDependencies": {
    "@fontsource/inter": "^5.3.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "firebase": "^13.1.0",
    "playwright": "1.63.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^7.3.7",
    "vitest": "^5.0.5",
    "wabt": "1.0.39"
  }
}
